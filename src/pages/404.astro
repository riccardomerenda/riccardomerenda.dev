---
import V2Layout from '../layouts/V2Layout.astro';
---

<V2Layout title="404 — Lost in space">
  <main class="relative min-h-screen flex items-center justify-center px-6 overflow-hidden">
    <div class="aura w-[520px] h-[520px] left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2" style="background: color-mix(in srgb, var(--color-signal-500) 8%, transparent);"></div>

    <div class="relative z-10 text-center max-w-xl">
      <p class="font-mono text-[13px] tracking-[0.25em] uppercase text-signal-500 mb-6">// signal lost</p>

      <h1 class="display text-[6rem] md:text-[11rem] leading-none text-gradient mb-8">404</h1>

      <div class="inline-block text-left rounded-xl border border-ink-800 bg-ink-900/60 overflow-hidden mb-9">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-ink-800">
          <span class="w-2 h-2 rounded-full bg-ink-700"></span>
          <span class="w-2 h-2 rounded-full bg-ink-700"></span>
          <span class="w-2 h-2 rounded-full bg-ink-700"></span>
          <span class="ml-2 font-mono text-[11px] text-ink-600">bash</span>
        </div>
        <div class="px-5 py-4 font-mono text-sm">
          <div class="text-ink-400"><span class="text-signal-500">$</span> curl riccardomerenda.dev{Astro.url.pathname}</div>
          <div class="text-red-400 mt-1">curl: (404) no such constellation</div>
          <div class="text-ink-400 mt-2"><span class="text-signal-500">$</span><span class="inline-block w-2 h-4 bg-signal-500 align-middle ml-1 animate-pulse"></span></div>
        </div>
      </div>

      <p class="text-ink-400 leading-relaxed mb-9">
        This page drifted off the map. Let’s navigate back to familiar stars.
      </p>

      <a href="/" class="inline-flex items-center gap-2 rounded-full bg-signal-500 px-7 py-3.5 font-medium text-ink-950 hover:bg-signal-400 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 12H5M11 18l-6-6 6-6"/></svg>
        Back to home
      </a>
    </div>
  </main>

  <script>
    // scroll progress (sticky nav is absent here, so guard for it)
    (() => {
      const bar = document.getElementById('scroll-progress');
      const onScroll = () => {
        const h = document.documentElement;
        const p = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
        if (bar) bar.style.transform = `scaleX(${p})`;
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</V2Layout>
